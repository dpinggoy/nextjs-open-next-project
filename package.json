{
  "name": "bps-test-project",
  "version": "0.1.0",
  "bin": {
    "bps-test-project": "bin/bps-test-project.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:open-next": "open-next build",
    "start": "next start",
    "cdk": "cdk",
    "cdk:bootstrap": "npx aws-cdk bootstrap",
    "cdk:synth:dev": "cdk synth --app 'npx ts-node --prefer-ts-exts bin/app-dev.ts",
    "cdk:synth:staging": "cdk synth --app 'npx ts-node --prefer-ts-exts bin/app-staging.ts",
    "cdk:synth:prod": "cdk synth --app 'npx ts-node --prefer-ts-exts bin/app-prod.ts",
    "cdk:diff:dev": "cdk diff --app 'npx ts-node --project tsconfig.cdk.json --transpile-only --prefer-ts-exts bin/app-dev.ts'",
    "cdk:diff:staging": "cdk diff --app 'npx ts-node --project tsconfig.cdk.json --transpile-only --prefer-ts-exts bin/app-staging.ts'",
    "cdk:diff:prod": "cdk diff --app 'npx ts-node --project tsconfig.cdk.json --transpile-only --prefer-ts-exts bin/app-prod.ts'",
    "cdk:deploy:dev": "npm run build && npm run build:open-next && cdk deploy --app 'npx ts-node --project tsconfig.cdk.json --transpile-only --prefer-ts-exts bin/app-dev.ts' --require-approval never",
    "cdk:deploy:staging": "npm run build && npm run build:open-next && cdk deploy --app 'npx ts-node --project tsconfig.cdk.json --transpile-only --prefer-ts-exts bin/app-staging.ts' --require-approval never",
    "cdk:deploy:prod": "npm run build && npm run build:open-next && cdk deploy --app 'npx ts-node --project tsconfig.cdk.json --transpile-only --prefer-ts-exts bin/app-prod.ts'",
    "cdk:destroy:dev": "cdk destroy --app 'npx ts-node --project tsconfig.cdk.json --transpile-only --prefer-ts-exts bin/app-dev.ts'",
    "cdk:destroy:staging": "cdk destroy --app 'npx ts-node --project tsconfig.cdk.json --transpile-only --prefer-ts-exts bin/app-staging.ts'",
    "cdk:destroy:prod": "cdk destroy --app 'npx ts-node --project tsconfig.cdk.json --transpile-only --prefer-ts-exts bin/app-prod.ts'",
    "deploy": "npm run build && npm run build:open-next && npm run cdk:deploy"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "22.7.9",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "aws-cdk": "^2.1030.0",
    "jest": "^29.7.0",
    "open-next": "^3.1.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.4.2",
    "next": "^15.5.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
